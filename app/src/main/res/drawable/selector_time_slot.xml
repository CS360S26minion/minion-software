<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected -->
    <item android:state_selected="true" android:drawable="@drawable/bg_pill_primary" />
    <!-- Booked/Disabled -->
    <item android:state_enabled="false" android:drawable="@drawable/bg_pill_surface" />
    <!-- Default Available -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/divider" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>
