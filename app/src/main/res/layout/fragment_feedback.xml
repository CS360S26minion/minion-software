<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?actionBarItemBackground"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="-12dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Counselling.Display"
            android:text="How was your session?"
            android:layout_marginBottom="24dp" />

        <!-- Counselor summary -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Counselling.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <com.example.counselling_system.ui.common.AvatarView
                    android:id="@+id/ivCounselorAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:src="@drawable/bg_avatar_placeholder" />

                <TextView
                    android:id="@+id/tvCounselorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="@style/TextAppearance.Counselling.SectionHeader"
                    android:textSize="15sp"
                    app:layout_constraintStart_toEndOf="@id/ivCounselorAvatar"
                    app:layout_constraintTop_toTopOf="@id/ivCounselorAvatar"
                    tools:text="Dr. Sarah Jenkins" />

                <TextView
                    android:id="@+id/tvSessionDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="@style/TextAppearance.Counselling.Caption"
                    app:layout_constraintStart_toEndOf="@id/ivCounselorAvatar"
                    app:layout_constraintTop_toBottomOf="@id/tvCounselorName"
                    tools:text="Mar 11, 2026" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Counselling.Chip.Status"
                    app:chipBackgroundColor="@color/primary_light"
                    android:textColor="@color/primary"
                    android:text="Smart Counseling"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rating Section -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Counselling.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Counselling.SectionHeader"
                    android:textSize="14sp"
                    android:text="Tell us your feedback:"
                    android:layout_marginBottom="16dp" />

                <com.example.counselling_system.ui.common.StarRatingView
                    android:id="@+id/starRatingFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Multi-select chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                    
                    <ToggleButton
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textOff="Helpful"
                        android:textOn="Helpful"
                        android:background="@drawable/selector_option_chip"
                        android:textAppearance="@style/TextAppearance.Counselling.Caption"
                        android:textColor="?android:attr/textColorPrimary"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />

                    <ToggleButton
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textOff="Empathetic"
                        android:textOn="Empathetic"
                        android:background="@drawable/selector_option_chip"
                        android:textAppearance="@style/TextAppearance.Counselling.Caption"
                        android:textColor="?android:attr/textColorPrimary"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />

                    <ToggleButton
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textOff="Professional"
                        android:textOn="Professional"
                        android:background="@drawable/selector_option_chip"
                        android:textAppearance="@style/TextAppearance.Counselling.Caption"
                        android:textColor="?android:attr/textColorPrimary"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />

                    <ToggleButton
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textOff="Clear"
                        android:textOn="Clear"
                        android:background="@drawable/selector_option_chip"
                        android:textAppearance="@style/TextAppearance.Counselling.Caption"
                        android:textColor="?android:attr/textColorPrimary"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Counselling.TextInput.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Any other thoughts?">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="3"
                        android:inputType="textMultiLine"
                        android:gravity="top|start" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSubmitFeedback"
            style="@style/Widget.Counselling.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Feedback" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
